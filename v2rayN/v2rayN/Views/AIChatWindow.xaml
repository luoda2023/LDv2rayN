<Window
    x:Class="v2rayN.Views.AIChatWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Title="🤖 AI智能代理助手"
    Width="750"
    Height="650"
    MinWidth="550"
    MinHeight="450"
    WindowStartupLocation="CenterOwner"
    Topmost="True"
    Background="#1E1E2E">

    <Grid Margin="8">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <Border Grid.Row="0" Background="#313244" CornerRadius="10,10,0,0" Padding="16,10" Margin="0,0,0,2">
            <Grid>
                <StackPanel Orientation="Horizontal">
                    <TextBlock FontSize="17" FontWeight="Bold" Foreground="#CDD6F4" Text="🤖 AI智能代理助手" VerticalAlignment="Center"/>
                </StackPanel>
                <TextBlock Foreground="#6C7086" FontSize="12" VerticalAlignment="Center" HorizontalAlignment="Right"
                    Text="粘贴链接让AI分析  |  或让AI自动搜索免费节点"/>
            </Grid>
        </Border>

        <!-- Settings Bar -->
        <Border Grid.Row="1" Background="#181825" Padding="10,6" Margin="0,0,0,2">
            <StackPanel Orientation="Horizontal">
                <TextBlock VerticalAlignment="Center" Foreground="#A6ADC8" Text="分组:" Margin="0,0,4,0"/>
                <TextBox x:Name="txtTargetGroup" Width="110" Background="#313244" Foreground="#CDD6F4" BorderBrush="#45475A" Text="AI自动获取" FontSize="12" VerticalContentAlignment="Center" Padding="4,2"/>
                <TextBlock VerticalAlignment="Center" Foreground="#A6ADC8" Text="  最大节点:" Margin="8,0,4,0"/>
                <TextBox x:Name="txtMaxNodes" Width="50" Background="#313244" Foreground="#CDD6F4" BorderBrush="#45475A" Text="50" FontSize="12" VerticalContentAlignment="Center" Padding="4,2"/>
                <CheckBox x:Name="chkAutoTest" IsChecked="True" VerticalAlignment="Center" Foreground="#A6ADC8" Margin="10,0,0,0" Content="自动验证"/>
            </StackPanel>
        </Border>

        <!-- Chat Messages Area -->
        <Border Grid.Row="2" Background="#11111B" Padding="4">
            <ScrollViewer x:Name="scrollChat" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                <ItemsControl x:Name="chatItems" ItemsSource="{Binding Messages}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Grid Margin="0,3">
                                <!-- User message (right-aligned bubble) -->
                                <Border Background="#45475A" CornerRadius="12,12,2,12" Padding="14,10" Margin="60,4,10,4"
                                        HorizontalAlignment="Right" MaxWidth="525"
                                        Visibility="{Binding IsUser, Converter={StaticResource BoolToVis}}">
                                    <StackPanel>
                                        <TextBlock Text="{Binding Content}" Foreground="#CDD6F4" FontSize="13.5" TextWrapping="Wrap"/>
                                        <TextBlock Text="{Binding Timestamp, StringFormat='{}{0:HH:mm}'}" Foreground="#6C7086" FontSize="10" HorizontalAlignment="Right" Margin="0,4,0,0"/>
                                    </StackPanel>
                                </Border>

                                <!-- AI message (left-aligned bubble) -->
                                <Border Background="#313244" CornerRadius="12,12,12,2" Padding="14,10" Margin="10,4,60,4"
                                        HorizontalAlignment="Left" MaxWidth="525"
                                        Visibility="{Binding IsAI, Converter={StaticResource BoolToVis}}">
                                    <StackPanel>
                                        <TextBlock Text="{Binding Content}" Foreground="#CDD6F4" FontSize="13.5" TextWrapping="Wrap"/>
                                        <TextBlock Text="{Binding Timestamp, StringFormat='{}{0:HH:mm}'}" Foreground="#6C7086" FontSize="10" HorizontalAlignment="Right" Margin="0,4,0,0"/>
                                    </StackPanel>
                                </Border>

                                <!-- System message (centered, with node results) -->
                                <Border Background="#181825" BorderBrush="#45475A" BorderThickness="1" CornerRadius="8" Padding="12,8"
                                        Margin="80,6,80,6" HorizontalAlignment="Center"
                                        Visibility="{Binding IsSystem, Converter={StaticResource BoolToVis}}">
                                    <StackPanel>
                                        <TextBlock Text="{Binding Content}" Foreground="#F9E2AF" FontSize="12" FontWeight="SemiBold" TextWrapping="Wrap"/>
                                        <ItemsControl ItemsSource="{Binding NodeResults}" Margin="0,6,0,0">
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate>
                                                    <Border CornerRadius="6" Padding="10,6" Margin="0,2" BorderThickness="1">
                                                        <Border.Style>
                                                            <Style TargetType="Border">
                                                                <Setter Property="Background" Value="#1E3A2B"/>
                                                                <Setter Property="BorderBrush" Value="#A6E3A1"/>
                                                                <Style.Triggers>
                                                                    <DataTrigger Binding="{Binding Status}" Value="Failed">
                                                                        <Setter Property="Background" Value="#3A1E1E"/>
                                                                        <Setter Property="BorderBrush" Value="#F38BA8"/>
                                                                    </DataTrigger>
                                                                    <DataTrigger Binding="{Binding Status}" Value="Testing">
                                                                        <Setter Property="Background" Value="#3A3A1E"/>
                                                                        <Setter Property="BorderBrush" Value="#F9E2AF"/>
                                                                    </DataTrigger>
                                                                </Style.Triggers>
                                                            </Style>
                                                        </Border.Style>
                                                        <Grid ColumnDefinitions="Auto,*,Auto">
                                                            <TextBlock Grid.Column="0" Text="{Binding Protocol}" Foreground="#89B4FA" FontWeight="Bold" FontSize="11" VerticalAlignment="Center" Margin="0,0,8,0"/>
                                                            <StackPanel Grid.Column="1">
                                                                <TextBlock Text="{Binding DisplayName}" Foreground="#CDD6F4" FontSize="12"/>
                                                                <TextBlock Text="{Binding Address}" Foreground="#6C7086" FontSize="10"/>
                                                            </StackPanel>
                                                            <TextBlock Grid.Column="2" Text="{Binding StatusText}" FontSize="11" VerticalAlignment="Center" Margin="8,0,0,0">
                                                                <TextBlock.Style>
                                                                    <Style TargetType="TextBlock">
                                                                        <Setter Property="Foreground" Value="#A6E3A1"/>
                                                                        <Style.Triggers>
                                                                            <DataTrigger Binding="{Binding Status}" Value="Failed">
                                                                                <Setter Property="Foreground" Value="#F38BA8"/>
                                                                            </DataTrigger>
                                                                            <DataTrigger Binding="{Binding Status}" Value="Testing">
                                                                                <Setter Property="Foreground" Value="#F9E2AF"/>
                                                                            </DataTrigger>
                                                                        </Style.Triggers>
                                                                    </Style>
                                                                </TextBlock.Style>
                                                            </TextBlock>
                                                        </Grid>
                                                    </Border>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                        <TextBlock Text="{Binding Timestamp, StringFormat='{}{0:HH:mm}'}" Foreground="#6C7086" FontSize="10" HorizontalAlignment="Right" Margin="0,4,0,0"/>
                                    </StackPanel>
                                </Border>
                            </Grid>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>
        </Border>

        <!-- Input Bar -->
        <Border Grid.Row="3" Background="#181825" CornerRadius="0,0,10,10" Padding="10,8">
            <Grid ColumnDefinitions="*,Auto,Auto">
                <TextBox x:Name="txtInput" Grid.Column="0" Background="#313244" Foreground="#CDD6F4" BorderBrush="#45475A" FontSize="14" Padding="10,8"
                         VerticalContentAlignment="Center" KeyDown="TxtInput_KeyDown" CaretBrush="#CDD6F4"/>
                <Button x:Name="btnAnalyzeUrl" Grid.Column="1" Width="110" Margin="8,0,0,0" Padding="10,8"
                        Background="#89B4FA" Foreground="#1E1E2E" FontWeight="Bold" FontSize="13"
                        Content="🔍 分析链接" Click="BtnAnalyzeUrl_Click"/>
                <Button x:Name="btnAutoSearch" Grid.Column="2" Width="110" Margin="6,0,0,0" Padding="10,8"
                        Background="#A6E3A1" Foreground="#1E1E2E" FontWeight="Bold" FontSize="13"
                        Content="🤖 自动搜索" Click="BtnAutoSearch_Click"/>
            </Grid>
        </Border>
    </Grid>

    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis"/>
    </Window.Resources>
</Window>
