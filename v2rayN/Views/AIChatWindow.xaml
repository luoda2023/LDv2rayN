 <Window x:Class="v2rayN.Views.AIChatWindow"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 xmlns:views="clr-namespace:v2rayN.Views"
 xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
 Title="AI 助手"
 Width="380" Height="520"
 MinWidth="300" MinHeight="380"
 Style="{StaticResource WindowGlobal}"
 WindowStyle="None"
 ResizeMode="CanResizeWithGrip"
 Topmost="True"
 ShowInTaskbar="False"
 WindowStartupLocation="Manual"
 FontFamily="Microsoft YaHei, Segoe UI, Arial"
 Icon="/Resources/NotifyIcon1.ico">

    <Grid Margin="8"> <Grid.RowDefinitions>
 <RowDefinition Height="Auto"/>
 <RowDefinition Height="*"/>
 <RowDefinition Height="Auto"/>
 <RowDefinition Height="Auto"/>
 </Grid.RowDefinitions>

        <!-- Header (drag handle) -->
        <Border Grid.Row="0" CornerRadius="6,6,0,0" Padding="12,8" Margin="0,0,0,4"
                BorderThickness="1"
                Background="{DynamicResource MaterialDesignCardBackground}"
                BorderBrush="{DynamicResource MaterialDesignDivider}"
                MouseLeftButtonDown="Header_MouseLeftButtonDown">
            <Grid> <TextBlock FontSize="14" FontWeight="Bold" VerticalAlignment="Center"
 Text="AI 助手"
 Foreground="{DynamicResource MaterialDesignBody}"/> <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
 <Button x:Name="btnSettings" Style="{StaticResource MaterialDesignIconButton}"
 Width="28" Height="28" Padding="0" Margin="0,0,2,0"
 ToolTip="AI 配置"
 Click="BtnSettings_Click">
 <materialDesign:PackIcon Kind="CogOutline" Width="16" Height="16" />
 </Button>
 <Button x:Name="btnMinimize" Style="{StaticResource MaterialDesignIconButton}"
 Width="28" Height="28" Padding="0" Margin="0,0,2,0"
 ToolTip="最小化"
 Click="BtnMinimize_Click">
 <materialDesign:PackIcon Kind="WindowMinimize" Width="16" Height="16" />
 </Button>
 <Button x:Name="btnClose" Style="{StaticResource MaterialDesignIconButton}"
 Width="28" Height="28" Padding="0" Margin="2,0,0,0"
 ToolTip="关闭"
 Click="BtnClose_Click">
 <materialDesign:PackIcon Kind="WindowClose" Width="16" Height="16" />
 </Button>
 </StackPanel>
            </Grid>
        </Border>

        <!-- Chat Messages -->
        <Border Grid.Row="1" CornerRadius="0,0,0,0" Padding="6,4"
                Background="{DynamicResource MaterialDesignCardBackground}"
                BorderThickness="1"
                BorderBrush="{DynamicResource MaterialDesignDivider}">
            <ScrollViewer x:Name="scrollChat" VerticalScrollBarVisibility="Auto"
                          HorizontalScrollBarVisibility="Disabled">
                <ItemsControl x:Name="chatItems" ItemsSource="{Binding Messages}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Grid Margin="0,3">
                                <Border CornerRadius="10,10,2,10" Padding="10,8"
                                        Margin="0,3,16,3" HorizontalAlignment="Right"
                                        MaxWidth="{Binding BubbleMaxWidth, RelativeSource={RelativeSource AncestorType=Window}}"
                                        Background="{DynamicResource MaterialDesignSelection}"
                                        Visibility="{Binding IsUser, Converter={StaticResource BoolToVis}}">
                                    <StackPanel>
                                        <views:MarkdownText Text="{Binding Content}" FontSize="13"
                                                             Foreground="{DynamicResource MaterialDesignBody}"/>
                                        <TextBlock Text="{Binding Timestamp, StringFormat='{}{0:HH:mm}'}"
                                                   FontSize="10" HorizontalAlignment="Right" Margin="0,4,0,0"
                                                   Foreground="{DynamicResource MaterialDesignBody}"/>
                                    </StackPanel>
                                </Border>

                                <Border CornerRadius="10,10,10,2" Padding="10,8"
                                        Margin="16,3,0,3" HorizontalAlignment="Left"
                                        MaxWidth="{Binding BubbleMaxWidth, RelativeSource={RelativeSource AncestorType=Window}}"
                                        Background="{DynamicResource MaterialDesignSelection}"
                                        Visibility="{Binding IsAI, Converter={StaticResource BoolToVis}}">
                                    <StackPanel>
                                        <views:MarkdownText Text="{Binding Content}" FontSize="13"
                                                             Foreground="{DynamicResource MaterialDesignBody}"/>
                                        <TextBlock Text="{Binding Timestamp, StringFormat='{}{0:HH:mm}'}"
                                                   FontSize="10" HorizontalAlignment="Right" Margin="0,4,0,0"
                                                   Foreground="{DynamicResource MaterialDesignBody}"/>
                                    </StackPanel>
                                </Border>

                                <Border CornerRadius="6" Padding="8,6" Margin="8,4,8,4"
                                        HorizontalAlignment="Center"
                                        BorderThickness="1"
                                        BorderBrush="{DynamicResource MaterialDesignDivider}"
                                        Background="{DynamicResource MaterialDesignCardBackground}"
                                        Visibility="{Binding IsSystem, Converter={StaticResource BoolToVis}}">
                                    <views:MarkdownText Text="{Binding Content}" FontSize="11"
                                                         Foreground="{DynamicResource MaterialDesignBody}"/>
                                </Border>
                            </Grid>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>
        </Border>

 <!-- Progress bar (visible while processing) -->
 <Grid Grid.Row="2" Visibility="{Binding IsProcessing, Converter={StaticResource BoolToVis}}"
 Margin="0,6,0,0">
 <ProgressBar IsIndeterminate="True" Height="3"
 Foreground="{DynamicResource MaterialDesignPrimaryBrush}" />
 <TextBlock Text="正在搜索免费节点，请稍候…" FontSize="11" Margin="0,8,0,0"
 HorizontalAlignment="Center"
 Foreground="{DynamicResource MaterialDesignBody}" />
 </Grid>

 <!-- Input -->
 <Border Grid.Row="3" CornerRadius="0,0,6,6" Padding="8" Margin="0,4,0,0"
                Background="{DynamicResource MaterialDesignCardBackground}"
                BorderThickness="1"
                BorderBrush="{DynamicResource MaterialDesignDivider}">
            <Grid ColumnDefinitions="*,Auto">
                <TextBox x:Name="txtInput" Grid.Column="0" Padding="8,6" FontSize="13"
                         materialDesign:HintAssist.Hint="Send message..."
                         BorderBrush="{DynamicResource MaterialDesignDivider}"
                         KeyDown="TxtInput_KeyDown"/>
                <Button x:Name="btnSend" Grid.Column="1" Margin="6,0,0,0"
                        Style="{StaticResource MaterialDesignRaisedButton}"
                        Content="Send" Click="BtnSend_Click"/>
            </Grid>
        </Border>
    </Grid>

    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis"/>
    </Window.Resources>
</Window>
