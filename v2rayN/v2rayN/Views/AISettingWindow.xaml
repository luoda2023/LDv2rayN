<Window
    x:Class="v2rayN.Views.AISettingWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:resx="clr-namespace:ServiceLib.Resx;assembly=ServiceLib"
    Title="AI智能获取设置"
    Width="600"
    Height="500"
    WindowStartupLocation="CenterOwner">
    <Grid Margin="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <TextBlock
            Grid.Row="0"
            Margin="0,0,0,10"
            FontSize="16"
            FontWeight="Bold"
            Text="🤖 AI智能获取免费VPN节点" />

        <ScrollViewer Grid.Row="1">
            <StackPanel>
                <TextBlock
                    Margin="0,0,0,10"
                    TextWrapping="Wrap"
                    Text="通过AI自动搜索GitHub上的免费VPN节点，自动验证后添加到分组中" />

                <Separator Margin="0,10" />

                <Grid Margin="0,10">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="120" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <TextBlock
                        Grid.Row="0"
                        Grid.Column="0"
                        Margin="0,5"
                        VerticalAlignment="Center"
                        Text="启用AI功能" />
                    <CheckBox
                        x:Name="chkAIEnabled"
                        Grid.Row="0"
                        Grid.Column="1"
                        Margin="0,5"
                        VerticalAlignment="Center" />

                    <TextBlock
                        Grid.Row="1"
                        Grid.Column="0"
                        Margin="0,5"
                        VerticalAlignment="Center"
                        Text="API地址" />
                    <TextBox
                        x:Name="txtApiUrl"
                        Grid.Row="1"
                        Grid.Column="1"
                        Margin="0,5"
                        Width="400"
                        HorizontalAlignment="Left"
                        Text="http://47.114.75.115:40000/v1" />

                    <TextBlock
                        Grid.Row="2"
                        Grid.Column="0"
                        Margin="0,5"
                        VerticalAlignment="Center"
                        Text="API密钥" />
                    <PasswordBox
                        x:Name="txtApiKey"
                        Grid.Row="2"
                        Grid.Column="1"
                        Margin="0,5"
                        Width="400"
                        HorizontalAlignment="Left" />

                    <TextBlock
                        Grid.Row="3"
                        Grid.Column="0"
                        Margin="0,5"
                        VerticalAlignment="Center"
                        Text="模型ID" />
                    <TextBox
                        x:Name="txtModelId"
                        Grid.Row="3"
                        Grid.Column="1"
                        Margin="0,5"
                        Width="400"
                        HorizontalAlignment="Left"
                        Text="hermesAPI" />

                    <TextBlock
                        Grid.Row="4"
                        Grid.Column="0"
                        Margin="0,5"
                        VerticalAlignment="Center"
                        Text="分组名称" />
                    <TextBox
                        x:Name="txtAiGroupRemarks"
                        Grid.Row="4"
                        Grid.Column="1"
                        Margin="0,5"
                        Width="400"
                        HorizontalAlignment="Left"
                        Text="AI自动获取" />

                    <TextBlock
                        Grid.Row="5"
                        Grid.Column="0"
                        Margin="0,5"
                        VerticalAlignment="Center"
                        Text="搜索间隔(分钟)" />
                    <TextBox
                        x:Name="txtSearchInterval"
                        Grid.Row="5"
                        Grid.Column="1"
                        Margin="0,5"
                        Width="200"
                        HorizontalAlignment="Left"
                        Text="60" />

                    <TextBlock
                        Grid.Row="6"
                        Grid.Column="0"
                        Margin="0,5"
                        VerticalAlignment="Center"
                        Text="每次最大节点数" />
                    <TextBox
                        x:Name="txtMaxNodes"
                        Grid.Row="6"
                        Grid.Column="1"
                        Margin="0,5"
                        Width="200"
                        HorizontalAlignment="Left"
                        Text="50" />
                </Grid>

                <Separator Margin="0,10" />

                <Button
                    x:Name="btnTestFetch"
                    Width="200"
                    Margin="0,10"
                    HorizontalAlignment="Left"
                    Content="🔍 立即测试AI获取" />

                <TextBlock
                    x:Name="txtStatus"
                    Margin="0,10"
                    Text="就绪"
                    TextWrapping="Wrap" />
            </StackPanel>
        </ScrollViewer>

        <StackPanel
            Grid.Row="2"
            Margin="0,10,0,0"
            HorizontalAlignment="Center"
            Orientation="Horizontal">
            <Button
                x:Name="btnSave"
                Width="100"
                Margin="0,0,10,0"
                Content="{x:Static resx:ResUI.TbConfirm}"
                IsDefault="True" />
            <Button
                x:Name="btnCancel"
                Width="100"
                Content="{x:Static resx:ResUI.TbCancel}"
                IsCancel="True" />
        </StackPanel>
    </Grid>
</Window>
