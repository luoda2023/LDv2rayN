<Window x:Class="v2rayN.Views.AIChatWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="AI 助手"
        Width="420" Height="580"
        MinWidth="320" MinHeight="400"
        WindowStyle="None"
        ResizeMode="CanResizeWithGrip"
        Topmost="True"
        ShowInTaskbar="False"
        WindowStartupLocation="Manual"
        FontFamily="Microsoft YaHei, Segoe UI, Arial"
        Icon="/Resources/NotifyIcon1.ico"
        Background="{DynamicResource MaterialDesignPaper}">

    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis"/>
        
        <!-- 主题跟随的按钮样式 -->
        <Style x:Key="ElegantButton" TargetType="Button">
            <Setter Property="Width" Value="24"/>
            <Setter Property="Height" Value="24"/>
            <Setter Property="Padding" Value="0"/>
            <Setter Property="Margin" Value="2"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Foreground" Value="{DynamicResource MaterialDesignBody}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" 
                                CornerRadius="4" 
                                Padding="4">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="{DynamicResource MaterialDesignDivider}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        
        <!-- 发送按钮样式 -->
        <Style x:Key="SendButtonStyle" TargetType="Button">
            <Setter Property="Width" Value="40"/>
            <Setter Property="Height" Value="36"/>
            <Setter Property="Padding" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Background" Value="{DynamicResource MaterialDesignPrimary}"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" 
                                CornerRadius="6" 
                                Padding="8">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="{DynamicResource MaterialDesignPrimaryDark}"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter Property="Background" Value="{DynamicResource MaterialDesignPrimaryDarker}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        
        <!-- 用户气泡样式 -->
        <Style x:Key="UserBubble" TargetType="Border">
            <Setter Property="Padding" Value="12,10"/>
            <Setter Property="Margin" Value="0,4,30,4"/>
            <Setter Property="HorizontalAlignment" Value="Right"/>
            <Setter Property="MaxWidth" Value="{Binding RelativeSource={RelativeSource AncestorType=Window}, Path=BubbleMaxWidth}"/>
            <Setter Property="Background" Value="{DynamicResource MaterialDesignPrimary}"/>
            <Setter Property="CornerRadius" Value="16,16,4,16"/>
        </Style>
        
        <!-- AI气泡样式 -->
        <Style x:Key="AIBubble" TargetType="Border">
            <Setter Property="Padding" Value="12,10"/>
            <Setter Property="Margin" Value="30,4,0,4"/>
            <Setter Property="HorizontalAlignment" Value="Left"/>
            <Setter Property="MaxWidth" Value="{Binding RelativeSource={RelativeSource AncestorType=Window}, Path=BubbleMaxWidth}"/>
            <Setter Property="Background" Value="{DynamicResource MaterialDesignCardBackground}"/>
            <Setter Property="CornerRadius" Value="16,16,16,4"/>
        </Style>
        
        <!-- 系统消息样式 -->
        <Style x:Key="SystemMessage" TargetType="Border">
            <Setter Property="Padding" Value="10,8"/>
            <Setter Property="Margin" Value="40,4,40,4"/>
            <Setter Property="HorizontalAlignment" Value="Center"/>
            <Setter Property="Background" Value="{DynamicResource MaterialDesignDivider}"/>
            <Setter Property="CornerRadius" Value="8"/>
        </Style>
    </Window.Resources>

    <Grid Margin="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <Border Grid.Row="0" Padding="16,12" Margin="0,0,0,8"
                Background="{DynamicResource MaterialDesignCardBackground}"
                MouseLeftButtonDown="Header_MouseLeftButtonDown">
            <Grid>
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="🤖" FontSize="20" Margin="0,0,8,0" VerticalAlignment="Center"/>
                    <TextBlock Text="AI 智能助手" FontSize="16" FontWeight="SemiBold" 
                               VerticalAlignment="Center"
                               Foreground="{DynamicResource MaterialDesignBody}"/>
                </StackPanel>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                    <Button x:Name="btnSettings" Style="{StaticResource ElegantButton}"
                            ToolTip="AI 配置"
                            Click="BtnSettings_Click">
                        <TextBlock Text="⚙" FontSize="14"/>
                    </Button>
                    <Button x:Name="btnMinimize" Style="{StaticResource ElegantButton}"
                            ToolTip="最小化"
                            Click="BtnMinimize_Click">
                        <TextBlock Text="─" FontSize="14"/>
                    </Button>
                    <Button x:Name="btnClose" Style="{StaticResource ElegantButton}"
                            ToolTip="关闭"
                            Click="BtnClose_Click">
                        <TextBlock Text="✕" FontSize="14"/>
                    </Button>
                </StackPanel>
            </Grid>
        </Border>

        <!-- Chat Messages -->
        <Border Grid.Row="1" Padding="8"
                Background="{DynamicResource MaterialDesignCardBackground}">
            <ScrollViewer x:Name="scrollChat" VerticalScrollBarVisibility="Auto"
                          HorizontalScrollBarVisibility="Disabled">
                <ItemsControl x:Name="chatItems" ItemsSource="{Binding Messages}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Grid Margin="0,6">
                                <!-- User Message -->
                                <Border Style="{StaticResource UserBubble}"
                                        Visibility="{Binding IsUser, Converter={StaticResource BoolToVis}}">
                                    <Grid>
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition Height="Auto"/>
                                        </Grid.RowDefinitions>
                                        <TextBlock Grid.Row="0" Text="{Binding Content}" 
                                                   TextWrapping="Wrap"
                                                   FontSize="13"
                                                   Foreground="White"/>
                                        <StackPanel Grid.Row="1" Orientation="Horizontal" 
                                                    HorizontalAlignment="Right" Margin="0,6,0,0">
                                            <TextBlock Text="{Binding Timestamp, StringFormat='{}{0:HH:mm}'}"
                                                       FontSize="10" VerticalAlignment="Center"
                                                       Foreground="#99FFFFFF"/>
                                            <Button Style="{StaticResource ElegantButton}"
                                                    Click="CopyMessage_Click"
                                                    Tag="{Binding Content}"
                                                    Foreground="#99FFFFFF">
                                                <TextBlock Text="📋" FontSize="10"/>
                                            </Button>
                                        </StackPanel>
                                    </Grid>
                                </Border>

                                <!-- AI Message -->
                                <Border Style="{StaticResource AIBubble}"
                                        Visibility="{Binding IsAI, Converter={StaticResource BoolToVis}}">
                                    <Grid>
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition Height="Auto"/>
                                        </Grid.RowDefinitions>
                                        <TextBlock Grid.Row="0" Text="{Binding Content}" 
                                                   TextWrapping="Wrap"
                                                   FontSize="13"
                                                   Foreground="{DynamicResource MaterialDesignBody}"/>
                                        <StackPanel Grid.Row="1" Orientation="Horizontal" 
                                                    HorizontalAlignment="Right" Margin="0,6,0,0">
                                            <TextBlock Text="{Binding Timestamp, StringFormat='{}{0:HH:mm}'}"
                                                       FontSize="10" VerticalAlignment="Center"
                                                       Foreground="{DynamicResource MaterialDesignBody}"/>
                                            <Button Style="{StaticResource ElegantButton}"
                                                    Click="CopyMessage_Click"
                                                    Tag="{Binding Content}"
                                                    Foreground="{DynamicResource MaterialDesignBody}">
                                                <TextBlock Text="📋" FontSize="10"/>
                                            </Button>
                                        </StackPanel>
                                    </Grid>
                                </Border>

                                <!-- System Message -->
                                <Border Style="{StaticResource SystemMessage}"
                                        Visibility="{Binding IsSystem, Converter={StaticResource BoolToVis}}">
                                    <TextBlock Text="{Binding Content}" 
                                               TextWrapping="Wrap"
                                               FontSize="11"
                                               Foreground="{DynamicResource MaterialDesignBody}"
                                               TextAlignment="Center"/>
                                </Border>
                            </Grid>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>
        </Border>

        <!-- Progress bar -->
        <Border Grid.Row="2" Padding="0" Margin="0,8,0,0"
                Visibility="{Binding IsProcessing, Converter={StaticResource BoolToVis}}"
                Background="{DynamicResource MaterialDesignCardBackground}">
            <StackPanel Orientation="Vertical" Margin="12,8">
                <ProgressBar IsIndeterminate="True" Height="3"
                             Foreground="{DynamicResource MaterialDesignPrimary}"/>
                <TextBlock Text="正在搜索免费节点，请稍候…" FontSize="11" Margin="0,6,0,0"
                           HorizontalAlignment="Center"
                           Foreground="{DynamicResource MaterialDesignBody}"/>
            </StackPanel>
        </Border>

        <!-- Input -->
        <Border Grid.Row="3" Padding="12" Margin="0,4,0,0"
                Background="{DynamicResource MaterialDesignCardBackground}">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                
                <Button x:Name="btnTestAll" Grid.Column="0" Margin="0,0,8,0"
                        Style="{StaticResource ElegantButton}"
                        Width="32" Height="32" 
                        ToolTip="测试全部节点"
                        Click="BtnTestAll_Click">
                    <TextBlock Text="🔍" FontSize="14"/>
                </Button>
                
                <TextBox x:Name="txtInput" Grid.Column="1" Padding="10,8" FontSize="13"
                         Background="{DynamicResource MaterialDesignPaper}"
                         Foreground="{DynamicResource MaterialDesignBody}"
                         BorderBrush="{DynamicResource MaterialDesignDivider}"
                         BorderThickness="1"
                         VerticalContentAlignment="Center"
                         KeyDown="TxtInput_KeyDown"/>
                
                <Button x:Name="btnSend" Grid.Column="2" Margin="8,0,0,0"
                        Style="{StaticResource SendButtonStyle}"
                        Click="BtnSend_Click">
                    <TextBlock Text="➤" FontSize="16" Foreground="White"/>
                </Button>
            </Grid>
        </Border>
    </Grid>
</Window>
