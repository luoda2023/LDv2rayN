<Window
    x:Class="v2rayN.Desktop.Views.LeakDetectionWindow"
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:reactiveui="http://reactiveui.net"
    xmlns:vms="clr-namespace:ServiceLib.ViewModels;assembly=ServiceLib"
    Title="🔒 Leak Detection"
    Width="700"
    Height="550"
    x:DataType="vms:LeakDetectionViewModel"
    ShowInTaskbar="False"
    WindowStartupLocation="CenterScreen"
    mc:Ignorable="d">
    <DockPanel Margin="{StaticResource Margin8}">

        <!-- Top: Overall Status -->
        <Border
            DockPanel.Dock="Top"
            Margin="0,0,0,8"
            Padding="12"
            Background="{DynamicResource MaterialDesignBody}"
            CornerRadius="8">
            <StackPanel>
                <TextBlock
                    x:Name="txtOverallStatus"
                    FontSize="16"
                    FontWeight="Bold"
                    TextWrapping="Wrap" />
                <TextBlock
                    x:Name="txtStatusMessage"
                    Margin="0,4,0,0"
                    Foreground="{DynamicResource MaterialDesignBodyLight}"
                    TextWrapping="Wrap" />
            </StackPanel>
        </Border>

        <!-- Bottom: Buttons -->
        <StackPanel
            DockPanel.Dock="Bottom"
            Margin="0,8,0,0"
            HorizontalAlignment="Center"
            Orientation="Horizontal">
            <Button
                x:Name="btnRunDetection"
                Width="160"
                Margin="0,0,8,0"
                Content="🔍 Run Detection"
                Classes="DefButton" />
            <Button
                x:Name="btnClose"
                Width="100"
                Content="Close"
                Classes="DefButton" />
        </StackPanel>

        <!-- Center: Test Results -->
        <ScrollViewer VerticalScrollBarVisibility="Visible">
            <StackPanel Margin="4">

                <!-- IP Leak Test -->
                <Border
                    Margin="0,0,0,8"
                    Padding="12"
                    Background="{DynamicResource MaterialDesignBody}"
                    CornerRadius="8">
                    <StackPanel>
                        <TextBlock
                            x:Name="txtIpLeakStatus"
                            FontSize="14"
                            FontWeight="Bold" />
                        <TextBlock
                            x:Name="txtIpLeakDetails"
                            Margin="0,4,0,0"
                            Foreground="{DynamicResource MaterialDesignBodyLight}"
                            TextWrapping="Wrap" />
                    </StackPanel>
                </Border>

                <!-- DNS Leak Test -->
                <Border
                    Margin="0,0,0,8"
                    Padding="12"
                    Background="{DynamicResource MaterialDesignBody}"
                    CornerRadius="8">
                    <StackPanel>
                        <TextBlock
                            x:Name="txtDnsLeakStatus"
                            FontSize="14"
                            FontWeight="Bold" />
                        <TextBlock
                            x:Name="txtDnsLeakDetails"
                            Margin="0,4,0,0"
                            Foreground="{DynamicResource MaterialDesignBodyLight}"
                            TextWrapping="Wrap" />
                    </StackPanel>
                </Border>

                <!-- IPv6 Leak Test -->
                <Border
                    Margin="0,0,0,8"
                    Padding="12"
                    Background="{DynamicResource MaterialDesignBody}"
                    CornerRadius="8">
                    <StackPanel>
                        <TextBlock
                            x:Name="txtIpv6LeakStatus"
                            FontSize="14"
                            FontWeight="Bold" />
                        <TextBlock
                            x:Name="txtIpv6LeakDetails"
                            Margin="0,4,0,0"
                            Foreground="{DynamicResource MaterialDesignBodyLight}"
                            TextWrapping="Wrap" />
                    </StackPanel>
                </Border>

                <!-- WebRTC Leak Test -->
                <Border
                    Margin="0,0,0,8"
                    Padding="12"
                    Background="{DynamicResource MaterialDesignBody}"
                    CornerRadius="8">
                    <StackPanel>
                        <TextBlock
                            x:Name="txtWebRtcLeakStatus"
                            FontSize="14"
                            FontWeight="Bold" />
                        <TextBlock
                            x:Name="txtWebRtcLeakDetails"
                            Margin="0,4,0,0"
                            Foreground="{DynamicResource MaterialDesignBodyLight}"
                            TextWrapping="Wrap" />
                    </StackPanel>
                </Border>

            </StackPanel>
        </ScrollViewer>
    </DockPanel>
</Window>
