<Window x:Class="v2rayN.Views.AIChatWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
        Title="AI 助手"
        Width="420" Height="580"
        MinWidth="320" MinHeight="400"
        WindowStyle="None"
        ResizeMode="CanResizeWithGrip"
        Topmost="True"
        ShowInTaskbar="False"
        WindowStartupLocation="Manual"
        FontFamily="Microsoft YaHei, Segoe UI, Arial"
        Icon="/Resources/NotifyIcon1.ico"
        Background="#FF1E1E2E">

    <Window.Resources>
        <!-- Elegant Copy Button -->
        <Style x:Key="ElegantButton" TargetType="Button">
            <Setter Property="Width" Value="24"/>
            <Setter Property="Height" Value="24"/>
            <Setter Property="Padding" Value="0"/>
            <Setter Property="Margin" Value="2"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Foreground" Value="#99FFFFFF"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" 
                                CornerRadius="4" 
                                Padding="4">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="#33FFFFFF"/>
                                <Setter Property="Foreground" Value="White"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        
        <!-- Send Button Style -->
        <Style x:Key="SendButtonStyle" TargetType="Button">
            <Setter Property="Width" Value="40"/>
            <Setter Property="Height" Value="36"/>
            <Setter Property="Padding" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Background" Value="#FF6C63FF"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" 
                                CornerRadius="6" 
                                Padding="8">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="#FF5A52D5"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter Property="Background" Value="#FF4A42B5"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid Margin="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <Border Grid.Row="0" CornerRadius="12,12,0,0" Padding="16,12" Margin="0,0,0,8"
                Background="#FF252540"
                MouseLeftButtonDown="Header_MouseLeftButtonDown">
            <Grid>
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="🤖" FontSize="20" Margin="0,0,8,0" VerticalAlignment="Center"/>
                    <TextBlock Text="AI 智能助手" FontSize="16" FontWeight="SemiBold" 
                               VerticalAlignment="Center"
                               Foreground="#FFE0E0E0"/>
                </StackPanel>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                    <Button x:Name="btnSettings" Style="{StaticResource ElegantButton}"
                            ToolTip="AI 配置"
                            Click="BtnSettings_Click">
                        <TextBlock Text="⚙" FontSize="14"/>
                    </Button>
                    <Button x:Name="btnMinimize" Style="{StaticResource ElegantButton}"
                            ToolTip="最小化"
                            Click="BtnMinimize_Click">
                        <TextBlock Text="─" FontSize="14"/>
                    </Button>
                    <Button x:Name="btnClose" Style="{StaticResource ElegantButton}"
                            ToolTip="关闭"
                            Click="BtnClose_Click">
                        <TextBlock Text="✕" FontSize="14"/>
                    </Button>
                </StackPanel>
            </Grid>
        </Border>

        <!-- Chat Messages -->
        <Border Grid.Row="1" CornerRadius="8" Padding="8"
                Background="#FF2A2A45">
            <ScrollViewer x:Name="scrollChat" VerticalScrollBarVisibility="Auto"
                          HorizontalScrollBarVisibility="Disabled">
                <ItemsControl x:Name="chatItems" ItemsSource="{Binding Messages}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Grid Margin="0,6">
                                <!-- User Message -->
                                <Border CornerRadius="16,16,4,16" Padding="12,10"
                                        Margin="0,4,30,4" 
                                        HorizontalAlignment="Right"
                                        MaxWidth="320"
                                        Background="#FF6C63FF">
                                    <Grid>
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition Height="Auto"/>
                                        </Grid.RowDefinitions>
                                        <TextBlock Grid.Row="0" Text="{Binding Content}" 
                                                   TextWrapping="Wrap"
                                                   FontSize="13"
                                                   Foreground="White"/>
                                        <StackPanel Grid.Row="1" Orientation="Horizontal" 
                                                    HorizontalAlignment="Right" Margin="0,6,0,0">
                                            <TextBlock Text="{Binding Timestamp, StringFormat='{}{0:HH:mm}'}"
                                                       FontSize="10" VerticalAlignment="Center"
                                                       Foreground="#99FFFFFF"/>
                                            <Button Style="{StaticResource ElegantButton}"
                                                    Click="CopyMessage_Click"
                                                    Tag="{Binding Content}"
                                                    Foreground="#99FFFFFF">
                                                <TextBlock Text="📋" FontSize="10"/>
                                            </Button>
                                        </StackPanel>
                                    </Grid>
                                </Border>

                                <!-- AI Message -->
                                <Border CornerRadius="16,16,16,4" Padding="12,10"
                                        Margin="30,4,0,4" 
                                        HorizontalAlignment="Left"
                                        MaxWidth="320"
                                        Background="#FF3A3A5C">
                                    <Grid>
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition Height="Auto"/>
                                        </Grid.RowDefinitions>
                                        <TextBlock Grid.Row="0" Text="{Binding Content}" 
                                                   TextWrapping="Wrap"
                                                   FontSize="13"
                                                   Foreground="#FFE8E8E8"/>
                                        <StackPanel Grid.Row="1" Orientation="Horizontal" 
                                                    HorizontalAlignment="Right" Margin="0,6,0,0">
                                            <TextBlock Text="{Binding Timestamp, StringFormat='{}{0:HH:mm}'}"
                                                       FontSize="10" VerticalAlignment="Center"
                                                       Foreground="#99FFFFFF"/>
                                            <Button Style="{StaticResource ElegantButton}"
                                                    Click="CopyMessage_Click"
                                                    Tag="{Binding Content}">
                                                <TextBlock Text="📋" FontSize="10"/>
                                            </Button>
                                        </StackPanel>
                                    </Grid>
                                </Border>

                                <!-- System Message -->
                                <Border CornerRadius="8" Padding="10,8" Margin="40,4,40,4"
                                        HorizontalAlignment="Center"
                                        Background="#FF252540">
                                    <TextBlock Text="{Binding Content}" 
                                               TextWrapping="Wrap"
                                               FontSize="11"
                                               Foreground="#FF9E9E9E"
                                               TextAlignment="Center"/>
                                </Border>
                            </Grid>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>
        </Border>

        <!-- Progress bar -->
        <Border Grid.Row="2" CornerRadius="0" Padding="0" Margin="0,8,0,0"
                Background="#FF252540">
            <StackPanel Orientation="Vertical" Margin="12,8">
                <ProgressBar IsIndeterminate="True" Height="3"
                             Foreground="#FF6C63FF"/>
                <TextBlock Text="正在搜索免费节点，请稍候…" FontSize="11" Margin="0,6,0,0"
                           HorizontalAlignment="Center"
                           Foreground="#FF9E9E9E"/>
            </StackPanel>
        </Border>

        <!-- Input -->
        <Border Grid.Row="3" CornerRadius="0,0,12,12" Padding="12" Margin="0,4,0,0"
                Background="#FF252540">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                
                <Button x:Name="btnTestAll" Grid.Column="0" Margin="0,0,8,0"
                        Style="{StaticResource ElegantButton}"
                        Width="32" Height="32" 
                        ToolTip="测试全部节点"
                        Click="BtnTestAll_Click">
                    <TextBlock Text="🔍" FontSize="14"/>
                </Button>
                
                <TextBox x:Name="txtInput" Grid.Column="1" Padding="10,8" FontSize="13"
                         Background="#FF3A3A5C"
                         Foreground="White"
                         BorderBrush="#FF4A4A6A"
                         BorderThickness="1"
                         VerticalContentAlignment="Center"
                         KeyDown="TxtInput_KeyDown"/>
                
                <Button x:Name="btnSend" Grid.Column="2" Margin="8,0,0,0"
                        Style="{StaticResource SendButtonStyle}"
                        Click="BtnSend_Click">
                    <TextBlock Text="➤" FontSize="16" Foreground="White"/>
                </Button>
            </Grid>
        </Border>
    </Grid>
</Window>