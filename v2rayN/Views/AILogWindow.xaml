<Window
 x:Class="v2rayN.Views.AILogWindow"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 Title="AI Running Status"
 Width="720"
 Height="600"
 MinWidth="520"
 MinHeight="400"
 WindowStartupLocation="CenterOwner"
 Background="#1E1E2E">
 <Grid Margin="10">   <Grid.RowDefinitions>
   <RowDefinition Height="Auto"/>
   <RowDefinition Height="Auto"/>
   <RowDefinition Height="Auto"/>
   <RowDefinition Height="Auto"/>
   <RowDefinition Height="*"/>
   <RowDefinition Height="Auto"/>
  </Grid.RowDefinitions>
  <Border Grid.Row="0" Background="#313244" CornerRadius="8" Padding="14,10" Margin="0,0,0,8">
   <StackPanel>
    <Grid ColumnDefinitions="Auto,Auto,*">
     <TextBlock Grid.Column="0" Foreground="#A6ADC8" Text="State: " VerticalAlignment="Center" Margin="0,0,4,0"/>
     <Ellipse x:Name="dotState" Grid.Column="1" Width="10" Height="10" Fill="#A6E3A1" VerticalAlignment="Center" Margin="0,0,8,0"/>
     <TextBlock x:Name="txtState" Grid.Column="2" Foreground="#A6E3A1" FontWeight="SemiBold" Text="unknown"/>
    </Grid>
    <Grid ColumnDefinitions="Auto,*" Margin="0,2">
     <TextBlock Grid.Column="0" Foreground="#A6ADC8" Text="Last run: " VerticalAlignment="Center" Margin="0,0,4,0"/>
     <TextBlock x:Name="txtLastRun" Grid.Column="1" Foreground="#CDD6F4" Text="never"/>
    </Grid>
    <Grid ColumnDefinitions="Auto,*" Margin="0,2">
     <TextBlock Grid.Column="0" Foreground="#A6ADC8" Text="Last success: " VerticalAlignment="Center" Margin="0,0,4,0"/>
     <TextBlock x:Name="txtLastSuccess" Grid.Column="1" Foreground="#CDD6F4" Text="never"/>
    </Grid>
    <Grid ColumnDefinitions="Auto,*" Margin="0,2">
     <TextBlock Grid.Column="0" Foreground="#A6ADC8" Text="Nodes added: " VerticalAlignment="Center" Margin="0,0,4,0"/>
     <TextBlock x:Name="txtLastAdded" Grid.Column="1" Foreground="#89B4FA" FontWeight="SemiBold" Text="0"/>
    </Grid>
    <Grid ColumnDefinitions="Auto,*" Margin="0,2">
     <TextBlock Grid.Column="0" Foreground="#A6ADC8" Text="Failures: " VerticalAlignment="Center" Margin="0,0,4,0"/>
     <TextBlock x:Name="txtFailures" Grid.Column="1" Foreground="#CDD6F4" Text="0"/>
    </Grid>
    <Grid ColumnDefinitions="Auto,*" Margin="0,2">
     <TextBlock Grid.Column="0" Foreground="#A6ADC8" Text="Message: " VerticalAlignment="Center" Margin="0,0,4,0"/>
     <TextBlock x:Name="txtLastMsg" Grid.Column="1" Foreground="#CDD6F4" TextWrapping="Wrap" Text="-"/>
    </Grid>
   </StackPanel>
  </Border>
  <Border Grid.Row="1" Background="#181825" CornerRadius="8" Padding="14,8" Margin="0,0,0,8">
   <StackPanel>
    <TextBlock Foreground="#6C7086" FontSize="11" Text="最近一次搜索明细" Margin="0,0,0,4"/>
    <Grid ColumnDefinitions="Auto,Auto,*" Margin="0,2,0,0">
     <TextBlock Grid.Column="0" Foreground="#A6ADC8" FontSize="12" Text="仓库: " VerticalAlignment="Center"/>
     <TextBlock x:Name="txtReposFound" Grid.Column="1" Foreground="#CDD6F4" FontSize="12" FontWeight="SemiBold" Text="0"/>
     <TextBlock Grid.Column="2" Foreground="#6C7086" FontSize="11" Text="" Margin="8,0,0,0"/>
    </Grid>
    <Grid ColumnDefinitions="Auto,Auto,*" Margin="0,2,0,0">
     <TextBlock Grid.Column="0" Foreground="#A6ADC8" FontSize="12" Text="抓取: " VerticalAlignment="Center"/>
     <TextBlock x:Name="txtFetchedUrls" Grid.Column="1" Foreground="#CDD6F4" FontSize="12" FontWeight="SemiBold" Text="0"/>
     <TextBlock x:Name="txtFetchErrors" Grid.Column="2" Foreground="#6C7086" FontSize="11" Text="" Margin="8,0,0,0"/>
    </Grid>
    <Grid ColumnDefinitions="Auto,Auto,*" Margin="0,2,0,0">
     <TextBlock Grid.Column="0" Foreground="#A6ADC8" FontSize="12" Text="镜像回退: " VerticalAlignment="Center"/>
     <TextBlock x:Name="txtMirrorFallbacks" Grid.Column="1" Foreground="#F9E2AF" FontSize="12" FontWeight="SemiBold" Text="0"/>
     <TextBlock Grid.Column="2" Foreground="#6C7086" FontSize="11" Text="" Margin="8,0,0,0"/>
    </Grid>
    <Grid ColumnDefinitions="Auto,Auto,*" Margin="0,2,0,0">
     <TextBlock Grid.Column="0" Foreground="#A6ADC8" FontSize="12" Text="候选: " VerticalAlignment="Center"/>
     <TextBlock x:Name="txtCandidates" Grid.Column="1" Foreground="#CDD6F4" FontSize="12" FontWeight="SemiBold" Text="0"/>
     <TextBlock x:Name="txtCandidatesByProto" Grid.Column="2" Foreground="#6C7086" FontSize="11" Text="" Margin="8,0,0,0" TextTrimming="CharacterEllipsis"/>
    </Grid>
    <Grid ColumnDefinitions="Auto,Auto,*" Margin="0,2,0,0">
     <TextBlock Grid.Column="0" Foreground="#A6ADC8" FontSize="12" Text="测试: " VerticalAlignment="Center"/>
     <TextBlock Grid.Column="1" FontSize="12" VerticalAlignment="Center">
      <Run x:Name="txtPassed" Foreground="#A6E3A1" Text="0"/>
      <Run Foreground="#6C7086" Text=" 通过 / "/>
      <Run x:Name="txtFailed" Foreground="#F38BA8" Text="0"/>
      <Run Foreground="#6C7086" Text=" 失败" />
     </TextBlock>
     <TextBlock x:Name="txtPassedByProto" Grid.Column="2" Foreground="#6C7086" FontSize="11" Text="" Margin="8,0,0,0" TextTrimming="CharacterEllipsis"/>
    </Grid>
    <Grid ColumnDefinitions="Auto,*" Margin="0,2,0,0">
     <TextBlock Grid.Column="0" Foreground="#A6ADC8" FontSize="12" Text="导入: " VerticalAlignment="Center" Margin="0,0,4,0"/>
     <TextBlock x:Name="txtImported" Grid.Column="1" Foreground="#89B4FA" FontSize="12" FontWeight="SemiBold" Text="0"/>
    </Grid>
   </StackPanel>
  </Border>
  <Border Grid.Row="2" Background="#181825" CornerRadius="8" Padding="14,8" Margin="0,0,0,8">
   <StackPanel>
    <TextBlock Foreground="#6C7086" FontSize="11" Text="搜索 → 测试 → 导入 时间线" Margin="0,0,0,4"/>
    <ScrollViewer VerticalScrollBarVisibility="Auto" MaxHeight="130">
     <ItemsControl x:Name="timelineItems">
      <ItemsControl.ItemTemplate>
       <DataTemplate>
        <TextBlock Text="{Binding}" Foreground="#CDD6F4" FontSize="11" TextWrapping="Wrap" Margin="0,1"/>
       </DataTemplate>
      </ItemsControl.ItemTemplate>
     </ItemsControl>
    </ScrollViewer>
   </StackPanel>
  </Border>
  <Border Grid.Row="3" Background="#181825" CornerRadius="8" Padding="14,8" Margin="0,0,0,8">
   <StackPanel>
    <TextBlock Foreground="#6C7086" FontSize="11" Text="AI Config" Margin="0,0,0,4"/>
    <Grid ColumnDefinitions="Auto,*">
     <TextBlock Grid.Column="0" Foreground="#A6ADC8" FontSize="12" Text="API: " VerticalAlignment="Center" Margin="0,0,4,0"/>
     <TextBlock x:Name="txtApiUrl" Grid.Column="1" Foreground="#CDD6F4" FontSize="12" Text="" TextWrapping="Wrap"/>
    </Grid>
    <Grid ColumnDefinitions="Auto,*" Margin="0,2,0,0">
     <TextBlock Grid.Column="0" Foreground="#A6ADC8" FontSize="12" Text="Model: " VerticalAlignment="Center" Margin="0,0,4,0"/>
     <TextBlock x:Name="txtModel" Grid.Column="1" Foreground="#CDD6F4" FontSize="12" Text=""/>
    </Grid>
    <Grid ColumnDefinitions="Auto,*" Margin="0,2,0,0">
     <TextBlock Grid.Column="0" Foreground="#A6ADC8" FontSize="12" Text="Interval: " VerticalAlignment="Center" Margin="0,0,4,0"/>
     <TextBlock x:Name="txtInterval" Grid.Column="1" Foreground="#CDD6F4" FontSize="12" Text=""/>
    </Grid>
    <Grid ColumnDefinitions="Auto,*" Margin="0,2,0,0">
     <TextBlock Grid.Column="0" Foreground="#A6ADC8" FontSize="12" Text="Group: " VerticalAlignment="Center" Margin="0,0,4,0"/>
     <TextBlock x:Name="txtGroup" Grid.Column="1" Foreground="#CDD6F4" FontSize="12" Text=""/>
    </Grid>
   </StackPanel>
  </Border>
  <Border Grid.Row="4" Background="#11111B" CornerRadius="8" Padding="4">
   <DockPanel>
    <Border DockPanel.Dock="Top" Background="#181825" Padding="10,6" Margin="0,0,0,2" CornerRadius="6,6,0,0">
     <TextBlock Foreground="#6C7086" FontSize="11" Text="Recent AI log entries (up to 50)"/>
    </Border>
    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
     <ItemsControl x:Name="logItems" Margin="8,4">
      <ItemsControl.ItemTemplate>
       <DataTemplate>
        <Border Background="#1E1E2E" CornerRadius="6" Padding="8,4" Margin="0,2">
         <TextBlock Text="{Binding}" Foreground="#CDD6F4" FontSize="11" TextWrapping="Wrap" FontFamily="Consolas" />
        </Border>
       </DataTemplate>
      </ItemsControl.ItemTemplate>
     </ItemsControl>
    </ScrollViewer>
   </DockPanel>
  </Border>
  <StackPanel Grid.Row="5" Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,10,0,0">
   <Button x:Name="btnRefresh" Width="100" Margin="0,0,8,0" Content="Refresh" Style="{StaticResource DefButton}" Click="BtnRefresh_Click"/>
   <Button x:Name="btnClose" Width="100" Content="Close" IsCancel="True" Style="{StaticResource SecondaryButton}"/>
  </StackPanel>
 </Grid>
</Window>
