<base:WindowBase
    x:Class="v2rayN.Views.LeakDetectionWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:base="clr-namespace:v2rayN.Base"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:reactiveui="http://reactiveui.net"
    xmlns:vms="clr-namespace:ServiceLib.ViewModels;assembly=ServiceLib"
    Title="Leak Detection"
    Width="700"
    Height="550"
    x:TypeArguments="vms:LeakDetectionViewModel"
    ShowInTaskbar="False"
    Style="{StaticResource WindowGlobal}"
    WindowStartupLocation="CenterScreen"
    mc:Ignorable="d">
    <DockPanel Margin="{StaticResource Margin8}">

        <!-- Top: Overall Status -->
        <Border
            DockPanel.Dock="Top"
            Margin="0,0,0,8"
            Padding="12"
            Background="{DynamicResource MaterialDesignBody}"
            CornerRadius="8">
            <StackPanel>
                <TextBlock
                    x:Name="txtOverallStatus"
                    FontSize="16"
                    FontWeight="Bold"
                    TextWrapping="Wrap" />
                <TextBlock
                    x:Name="txtStatusMessage"
                    Margin="0,4,0,0"
                    Foreground="{DynamicResource MaterialDesignBodyLight}"
                    TextWrapping="Wrap" />
            </StackPanel>
        </Border>

        <!-- Bottom: Buttons -->
        <StackPanel
            DockPanel.Dock="Bottom"
            Margin="0,8,0,0"
            HorizontalAlignment="Center"
            Orientation="Horizontal">
<Button
x:Name="btnRunDetection"
Width="160"
Margin="0,0,8,0"
Style="{StaticResource DefButton}">
<StackPanel Orientation="Horizontal">
<materialDesign:PackIcon Kind="ShieldSearch" Width="16" Height="16" Margin="0,0,6,0"
VerticalAlignment="Center" />
<TextBlock Text="Run Detection" VerticalAlignment="Center" />
</StackPanel>
</Button>
            <Button
                x:Name="btnClose"
                Width="100"
                Content="Close"
                IsCancel="True"
                Style="{StaticResource SecondaryButton}" />
        </StackPanel>

        <!-- Center: Test Results -->
        <ScrollViewer VerticalScrollBarVisibility="Visible">
            <StackPanel Margin="4">

                <!-- IP Leak Test -->
                <Border
                    Margin="0,0,0,8"
                    Padding="12"
                    Background="{DynamicResource MaterialDesignBody}"
                    CornerRadius="8">
                    <StackPanel>
                        <TextBlock
                            x:Name="txtIpLeakStatus"
                            FontSize="14"
                            FontWeight="Bold" />
                        <TextBlock
                            x:Name="txtIpLeakDetails"
                            Margin="0,4,0,0"
                            Foreground="{DynamicResource MaterialDesignBodyLight}"
                            TextWrapping="Wrap" />
                    </StackPanel>
                </Border>

                <!-- DNS Leak Test -->
                <Border
                    Margin="0,0,0,8"
                    Padding="12"
                    Background="{DynamicResource MaterialDesignBody}"
                    CornerRadius="8">
                    <StackPanel>
                        <TextBlock
                            x:Name="txtDnsLeakStatus"
                            FontSize="14"
                            FontWeight="Bold" />
                        <TextBlock
                            x:Name="txtDnsLeakDetails"
                            Margin="0,4,0,0"
                            Foreground="{DynamicResource MaterialDesignBodyLight}"
                            TextWrapping="Wrap" />
                    </StackPanel>
                </Border>

                <!-- IPv6 Leak Test -->
                <Border
                    Margin="0,0,0,8"
                    Padding="12"
                    Background="{DynamicResource MaterialDesignBody}"
                    CornerRadius="8">
                    <StackPanel>
                        <TextBlock
                            x:Name="txtIpv6LeakStatus"
                            FontSize="14"
                            FontWeight="Bold" />
                        <TextBlock
                            x:Name="txtIpv6LeakDetails"
                            Margin="0,4,0,0"
                            Foreground="{DynamicResource MaterialDesignBodyLight}"
                            TextWrapping="Wrap" />
                    </StackPanel>
                </Border>

                <!-- WebRTC Leak Test -->
                <Border
                    Margin="0,0,0,8"
                    Padding="12"
                    Background="{DynamicResource MaterialDesignBody}"
                    CornerRadius="8">
                    <StackPanel>
                        <TextBlock
                            x:Name="txtWebRtcLeakStatus"
                            FontSize="14"
                            FontWeight="Bold" />
                        <TextBlock
                            x:Name="txtWebRtcLeakDetails"
                            Margin="0,4,0,0"
                            Foreground="{DynamicResource MaterialDesignBodyLight}"
                            TextWrapping="Wrap" />
                    </StackPanel>
                </Border>

            </StackPanel>
        </ScrollViewer>
    </DockPanel>
</base:WindowBase>
