<Window x:Class="v2rayN.Views.AIChatWindow"
xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
xmlns:views="clr-namespace:v2rayN.Views"
Title="AI 助手"
        Width="420" Height="580"
        MinWidth="320" MinHeight="400"
        WindowStyle="None"
        ResizeMode="CanResizeWithGrip"
        Topmost="True"
        ShowInTaskbar="False"
        WindowStartupLocation="Manual"
        FontFamily="Microsoft YaHei, Segoe UI, Arial"
        Icon="/Resources/LDv2rayN.ico"
        Background="{DynamicResource MaterialDesignCardBackground}">

    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis"/>
        
        <!-- 按钮统一走 App.xaml 的 Material 3 体系：IconButtonMini/Tiny/IconButton/SecondaryButton/DefButton -->
        
        <!-- 发送按钮：Material 3 实心主色按钮，图标用主色前景，悬停/按下加深 -->
        <Style x:Key="SendButtonStyle" TargetType="Button">
            <Setter Property="Width" Value="40"/>
            <Setter Property="Height" Value="36"/>
            <Setter Property="Padding" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Background" Value="{DynamicResource MaterialDesign.Brush.Primary}"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Foreground" Value="{DynamicResource MaterialDesign.Brush.Primary.Foreground}"/>
            <Setter Property="HorizontalContentAlignment" Value="Center"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" 
                                CornerRadius="8">
                            <ContentPresenter
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center"
                                RecognizesAccessKey="False"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="{DynamicResource MaterialDesign.Brush.Primary.Dark}"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter Property="Background" Value="{DynamicResource MaterialDesign.Brush.Primary.Dark}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        
<!-- 用户气泡样式：灰色背景跟随主题(MaterialDesignDivider)，文字用主题文字色，深浅主题都清晰 -->
<Style x:Key="UserBubble" TargetType="Border">
<Setter Property="Padding" Value="8,5"/>
<Setter Property="Margin" Value="0,1,3,1"/>
<Setter Property="HorizontalAlignment" Value="Right"/>
<Setter Property="MaxWidth" Value="{Binding RelativeSource={RelativeSource AncestorType=Window}, Path=BubbleMaxWidth}"/>
<Setter Property="Background" Value="{DynamicResource MaterialDesignDivider}"/>
<Setter Property="CornerRadius" Value="10,10,3,10"/>
</Style>

<!-- AI气泡样式：Padding 交给内层内容，便于半透明背景铺满整个圆角卡片 -->
<Style x:Key="AIBubble" TargetType="Border">
<Setter Property="Margin" Value="3,1,0,1"/>
<Setter Property="HorizontalAlignment" Value="Left"/>
<Setter Property="MaxWidth" Value="{Binding RelativeSource={RelativeSource AncestorType=Window}, Path=BubbleMaxWidth}"/>
</Style>

<!-- 系统消息样式 -->
<Style x:Key="SystemMessage" TargetType="Border">
<Setter Property="Margin" Value="10,1,10,1"/>
<Setter Property="HorizontalAlignment" Value="Center"/>
</Style>
        
        <!-- 仓库列表项样式 -->
        <Style x:Key="RepoItemBorder" TargetType="Border">
            <Setter Property="Padding" Value="8,6"/>
            <Setter Property="Margin" Value="0,2"/>
            <Setter Property="Background" Value="{DynamicResource MaterialDesignCardBackground}"/>
            <Setter Property="CornerRadius" Value="4"/>
            <Setter Property="BorderBrush" Value="{DynamicResource MaterialDesignDivider}"/>
            <Setter Property="BorderThickness" Value="1"/>
        </Style>
    </Window.Resources>

<Grid Margin="4">
<Grid.RowDefinitions>
<RowDefinition Height="Auto"/>
<RowDefinition Height="*"/>
<RowDefinition Height="Auto"/>
<RowDefinition Height="Auto"/>
<RowDefinition Height="Auto"/>
</Grid.RowDefinitions>

<!-- Header -->
<Border Grid.Row="0" Padding="8,6" Margin="0,0,0,4"
Background="{DynamicResource MaterialDesignCardBackground}"
MouseLeftButtonDown="Header_MouseLeftButtonDown">
            <Grid>
<StackPanel Orientation="Horizontal" VerticalAlignment="Center">
<materialDesign:PackIcon Kind="Robot" Width="20" Height="20" Margin="0,0,8,0" VerticalAlignment="Center"
Foreground="{DynamicResource MaterialDesignBody}"/>
<TextBlock Text="AI 智能助手" FontSize="16" FontWeight="SemiBold"
VerticalAlignment="Center"
Foreground="{DynamicResource MaterialDesignBody}"/>
</StackPanel>
<StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
<Button x:Name="btnSettings" Style="{StaticResource IconButtonTiny}"
ToolTip="AI 配置"
Click="BtnSettings_Click">
<materialDesign:PackIcon Kind="Cog" Width="16" Height="16"/>
</Button>
<Button x:Name="btnMinimize" Style="{StaticResource IconButtonTiny}"
ToolTip="最小化"
Click="BtnMinimize_Click">
<materialDesign:PackIcon Kind="WindowMinimize" Width="16" Height="16"/>
</Button>
<Button x:Name="btnClose" Style="{StaticResource IconButtonTiny}"
ToolTip="关闭"
Click="BtnClose_Click">
<materialDesign:PackIcon Kind="WindowClose" Width="16" Height="16"/>
</Button>
</StackPanel>
            </Grid>
        </Border>

<!-- Chat Messages -->
<Border Grid.Row="1" Padding="8"
Background="{DynamicResource MaterialDesignCardBackground}">
<ScrollViewer x:Name="scrollChat" VerticalScrollBarVisibility="Auto"
HorizontalScrollBarVisibility="Disabled">
<ScrollViewer.Resources>
<Style TargetType="ScrollBar" BasedOn="{StaticResource {x:Type ScrollBar}}">
<Setter Property="Width" Value="4"/>
<Setter Property="MinWidth" Value="4"/>
<Setter Property="Background" Value="Transparent"/>
<Setter Property="Template">
<Setter.Value>
<ControlTemplate TargetType="ScrollBar">
<Grid>
<Track Name="PART_Track" IsDirectionReversed="True">
<Track.DecreaseRepeatButton>
<RepeatButton Command="ScrollBar.PageUpCommand" Opacity="0"/>
</Track.DecreaseRepeatButton>
<Track.IncreaseRepeatButton>
<RepeatButton Command="ScrollBar.PageDownCommand" Opacity="0"/>
</Track.IncreaseRepeatButton>
<Track.Thumb>
<Thumb>
<Thumb.Style>
<Style TargetType="Thumb">
<Setter Property="Background" Value="{DynamicResource MaterialDesignDivider}"/>
<Setter Property="Template">
<Setter.Value>
<ControlTemplate TargetType="Thumb">
<Border Background="{TemplateBinding Background}" CornerRadius="2"/>
</ControlTemplate>
</Setter.Value>
</Setter>
</Style>
</Thumb.Style>
</Thumb>
</Track.Thumb>
</Track>
</Grid>
</ControlTemplate>
</Setter.Value>
</Setter>
</Style>
</ScrollViewer.Resources>
                <ItemsControl x:Name="chatItems" ItemsSource="{Binding Messages}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
 <Grid Margin="0,3">
 <Grid.ColumnDefinitions>
 <ColumnDefinition Width="*"/>
 <ColumnDefinition Width="Auto"/>
 </Grid.ColumnDefinitions>

 <!-- 左列：汽泡本体（用户+AI+系统都在这里），复制按钮已移到右列汽泡之外 -->
 <Grid Grid.Column="0">

 <!-- User Message -->
 <Border Style="{StaticResource UserBubble}"
 Visibility="{Binding IsUser, Converter={StaticResource BoolToVis}}">
 <Grid>
 <Grid.RowDefinitions>
 <RowDefinition Height="Auto"/>
 <RowDefinition Height="Auto"/>
 </Grid.RowDefinitions>
 <TextBlock Grid.Row="0" Text="{Binding Content}" 
 TextWrapping="Wrap"
 FontSize="13"
 Foreground="{DynamicResource MaterialDesignBody}"/>
 <TextBlock Grid.Row="1" Text="{Binding Timestamp, StringFormat='{}{0:HH:mm}'}"
 FontSize="10" HorizontalAlignment="Right" Margin="0,3,0,0"
 Foreground="{DynamicResource MaterialDesignBody}"
 Opacity="0.65"/>
 </Grid>
 </Border>

 <!-- AI Message -->
 <Border Style="{StaticResource AIBubble}"
 Visibility="{Binding IsAI, Converter={StaticResource BoolToVis}}">
 <Grid>
 <!-- 半透明卡片背景(80%)：透出底层灰得到柔和层次，文字在上层不透明不受影响 -->
 <Border Background="{DynamicResource MaterialDesignPaper}"
 BorderBrush="{DynamicResource MaterialDesignDivider}"
 BorderThickness="1"
 CornerRadius="16,16,16,4"
 Opacity="0.8"/>
 <Grid Margin="12,8">
 <Grid.RowDefinitions>
 <RowDefinition Height="Auto"/>
 <RowDefinition Height="Auto"/>
 </Grid.RowDefinitions>
 <views:MarkdownText Grid.Row="0" Text="{Binding Content}" FontSize="13"
 Foreground="{DynamicResource MaterialDesignBody}"/>
 <TextBlock Grid.Row="1" Text="{Binding Timestamp, StringFormat='{}{0:HH:mm}'}"
 FontSize="10" HorizontalAlignment="Right" Margin="0,3,0,0"
 Foreground="{DynamicResource MaterialDesignBody}"/>
 </Grid>
 </Grid>
 </Border>

                                <!-- System Message -->
                                <Border Style="{StaticResource SystemMessage}"
                                        Visibility="{Binding IsSystem, Converter={StaticResource BoolToVis}}">
                                    <Grid>
                                        <!-- 半透明灰条(80%)：透出底层，柔和 -->
                                        <Border Background="{DynamicResource MaterialDesignDivider}"
                                                CornerRadius="8"
                                                Opacity="0.8"/>
                                        <TextBlock Text="{Binding Content}" 
                                                   TextWrapping="Wrap"
                                                   Margin="10,6"
                                                   FontSize="11"
                                                   Foreground="{DynamicResource MaterialDesignBody}"
 TextAlignment="Center"/>
 </Grid>
 </Border>
 </Grid>

 <!-- 右列：复制按钮在汽泡之外，不再挤在气泡右下角内 -->
 <StackPanel Grid.Column="1" VerticalAlignment="Bottom" Margin="4,0,0,0">
 <Button Style="{StaticResource IconButtonMini}"
 Click="CopyMessage_Click"
 Tag="{Binding Content}"
 ToolTip="复制"
 Foreground="{DynamicResource MaterialDesignBody}">
 <materialDesign:PackIcon Kind="ContentCopy" Width="14" Height="14"/>
 </Button>
 </StackPanel>
 </Grid>
 </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>
        </Border>

        <!-- GitHub Repository Selection Panel -->
        <Border Grid.Row="2" Padding="8" Margin="0,8,0,0"
                Visibility="{Binding IsRepoListVisible, Converter={StaticResource BoolToVis}}"
                Background="{DynamicResource MaterialDesignCardBackground}">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>
                
<!-- Header -->
<StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,8">
<materialDesign:PackIcon Kind="Github" Width="16" Height="16" Margin="0,0,6,0"
VerticalAlignment="Center" Foreground="{DynamicResource MaterialDesignBody}"/>
<TextBlock Text="GitHub 仓库选择" FontSize="14" FontWeight="SemiBold"
Foreground="{DynamicResource MaterialDesignBody}"/>
<TextBlock Text="{Binding GitHubRepos.Count, StringFormat=' ({0} 个仓库)'}"
FontSize="12" VerticalAlignment="Center" Margin="8,0,0,0"
Foreground="{DynamicResource MaterialDesignBody}"/>
</StackPanel>
                
                <!-- Repository List -->
                <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" MaxHeight="200">
                    <ItemsControl ItemsSource="{Binding GitHubRepos}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Style="{StaticResource RepoItemBorder}">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        
                                        <CheckBox Grid.Column="0" 
                                                  IsChecked="{Binding IsSelected}"
                                                  Margin="0,0,8,0"
                                                  VerticalAlignment="Center"/>
                                        
                                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
<StackPanel Orientation="Horizontal">
<TextBlock Text="{Binding Repo}"
FontWeight="SemiBold" FontSize="12"
Foreground="{DynamicResource MaterialDesignBody}"/>
<materialDesign:PackIcon Kind="Star" Width="11" Height="11" Margin="8,0,2,0"
VerticalAlignment="Center" Foreground="{DynamicResource MaterialDesignBody}"/>
<TextBlock Text="{Binding Stars}"
FontSize="11"
VerticalAlignment="Center"
Foreground="{DynamicResource MaterialDesignBody}"/>
</StackPanel>
                                            <TextBlock Text="{Binding Description}" 
                                                       FontSize="10" TextWrapping="Wrap"
                                                       Foreground="{DynamicResource MaterialDesignBody}"
                                                       Opacity="0.7"/>
                                        </StackPanel>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>
                
                <!-- Action Buttons -->
                <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,8,0,0">
                    <Button Content="全选" Click="BtnSelectAll_Click"
                            Style="{StaticResource SecondaryButton}"
                            Height="30" MinWidth="0" Padding="10,0"
                            FontSize="12" Margin="0,0,8,0"/>
                    <Button Content="取消全选" Click="BtnDeselectAll_Click"
                            Style="{StaticResource SecondaryButton}"
                            Height="30" MinWidth="0" Padding="10,0"
                            FontSize="12" Margin="0,0,8,0"/>
                    <Button Content="导入所选" Click="BtnImportSelected_Click"
                            Style="{StaticResource DefButton}"
                            Height="30" MinWidth="0" Padding="12,0"
                            FontSize="12"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- Progress bar -->
        <Border Grid.Row="3" Padding="0" Margin="0,8,0,0"
                Visibility="{Binding IsProcessing, Converter={StaticResource BoolToVis}}"
                Background="{DynamicResource MaterialDesignCardBackground}">
            <StackPanel Orientation="Vertical" Margin="12,8">
                <ProgressBar IsIndeterminate="True" Height="3"
                             Foreground="{DynamicResource MaterialDesign.Brush.Primary}"/>
                <TextBlock Text="正在搜索免费节点，请稍候…" FontSize="11" Margin="0,6,0,0"
                           HorizontalAlignment="Center"
                           Foreground="{DynamicResource MaterialDesignBody}"/>
            </StackPanel>
        </Border>

        <!-- Input -->
        <Border Grid.Row="4" Padding="12" Margin="0,4,0,0"
                Background="{DynamicResource MaterialDesignCardBackground}">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                
<Button x:Name="btnTestAll" Grid.Column="0" Margin="0,0,8,0"
Style="{StaticResource IconButton}"
ToolTip="测试全部节点"
Click="BtnTestAll_Click">
<materialDesign:PackIcon Kind="Speedometer" Width="16" Height="16"/>
</Button>

<Button x:Name="btnSearchRepos" Grid.Column="1" Margin="0,0,8,0"
Style="{StaticResource IconButton}"
ToolTip="搜索GitHub仓库"
Click="BtnSearchRepos_Click">
<materialDesign:PackIcon Kind="Magnify" Width="16" Height="16"/>
</Button>
                
 <TextBox x:Name="txtInput" Grid.Column="2" Padding="10,8" FontSize="13"
 Background="{DynamicResource MaterialDesignPaper}"
 Foreground="{DynamicResource MaterialDesignBody}"
 BorderBrush="{DynamicResource MaterialDesignDivider}"
 BorderThickness="1"
 AcceptsReturn="True"
 TextWrapping="Wrap"
 VerticalScrollBarVisibility="Auto"
 MaxHeight="120"
 VerticalContentAlignment="Top"
 KeyDown="TxtInput_KeyDown"/>
                
<Button x:Name="btnSend" Grid.Column="3" Margin="8,0,0,0"
Style="{StaticResource SendButtonStyle}"
Click="BtnSend_Click">
<materialDesign:PackIcon Kind="Send" Width="18" Height="18"
HorizontalAlignment="Center"
VerticalAlignment="Center"/>
</Button>
            </Grid>
        </Border>
    </Grid>
</Window>
